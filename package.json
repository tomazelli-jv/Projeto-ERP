{
  "name": "tomazelli-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project backend/src/ERP.Api",
    "dev:web": "npm run dev --workspace=@tomazelli/web",
    "build": "dotnet build backend/ERP.sln --configuration Release && npm run build --workspace=@tomazelli/web",
    "lint": "eslint apps/web eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "dotnet test backend/ERP.sln --configuration Release",
    "test:coverage": "dotnet test backend/ERP.sln --configuration Release --collect:XPlat Code Coverage",
    "db:up": "docker compose up -d mariadb",
    "db:down": "docker compose down",
    "db:migrate": "dotnet run --project backend/src/ERP.Migrations -- up",
    "db:rollback": "dotnet run --project backend/src/ERP.Migrations -- down",
    "db:status": "dotnet run --project backend/src/ERP.Migrations -- status",
    "db:seed": "dotnet run --project backend/src/ERP.Migrations -- seed",
    "ci": "npm run format:check && npm run lint && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
