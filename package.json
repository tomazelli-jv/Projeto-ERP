{
  "name": "tomazelli-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@tomazelli/api",
    "dev:web": "npm run dev --workspace=@tomazelli/web",
    "build": "npm run build --workspace=@tomazelli/shared && npm run build --workspace=@tomazelli/api && npm run build --workspace=@tomazelli/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d mariadb",
    "db:down": "docker compose down",
    "db:migrate": "knex migrate:latest --knexfile database/knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile database/knexfile.js",
    "db:status": "knex migrate:list --knexfile database/knexfile.js",
    "db:seed": "node database/run-development-seeds.js",
    "ci": "npm run format:check && npm run lint && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "knex": "^3.1.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
