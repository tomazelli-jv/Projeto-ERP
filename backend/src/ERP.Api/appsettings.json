{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Web": {
    "Origins": []
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Authentication": {
    "AccessTokenMinutes": 10,
    "SessionDays": 30,
    "ClockSkewSeconds": 30,
    "RefreshCookieName": "erp_refresh",
    "LoginFailureLimit": 5,
    "LoginWindowMinutes": 15,
    "LoginBlockMinutes": 15
  }
}
