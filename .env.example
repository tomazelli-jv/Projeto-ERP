DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5001
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tomazelli_erp
DB_USER=tomazelli
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password
ConnectionStrings__MariaDb=Server=127.0.0.1;Port=3306;Database=tomazelli_erp;User ID=tomazelli;Password=change_me

PasswordSecurity__MemoryCostKiB=19456
PasswordSecurity__Iterations=2
PasswordSecurity__Parallelism=1

Authentication__Issuer=tomazelli-erp
Authentication__Audience=tomazelli-erp-web
Authentication__SigningKey=replace_with_at_least_32_random_bytes_outside_git
Authentication__AccessTokenMinutes=10
Authentication__SessionDays=30
Authentication__ClockSkewSeconds=30
Authentication__RefreshCookieName=erp_refresh
Authentication__LoginFailureLimit=5
Authentication__LoginWindowMinutes=15
Authentication__LoginBlockMinutes=15
